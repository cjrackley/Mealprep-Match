classDiagram
    class Provider {
        -id: Long
        -name: String
        -email: String
        -passwordHash: String
        -profilePicture: Blob
        -bio: String
        -specialties: List~String~
        -verified: Boolean
        +publishRecipe(recipe: Recipe)
        +publishMealplan(plan: Mealplan)
        +publishMealkit(kit: Mealkit)
        +viewStatistics() ProviderStats
        +replyToReview(review: Review, reply: String)
    }

    class Customer {
        -id: Long
        -name: String
        -email: String
        -passwordHash: String
        -dietaryPreferences: List~String~
        +browseContent(tag: String) List
        +searchProviders(specialty: String) List~Provider~
        +save(target: Recipe or Mealplan) Save
        +subscribe(kit: Mealkit) Subscription
        +writeReview(target, rating: Integer, comment: String) Review
    }

    class Recipe {
        -id: Long
        -title: String
        -ingredients: List~String~
        -instructions: String
        -tags: List~String~
        +getDetails()
    }

    class Mealplan {
        -id: Long
        -title: String
        -duration: String
        -schedule: String
        -description: String
        -category: String
        +addRecipe(recipe: Recipe)
        +getSchedule()
    }

    class Mealkit {
        -id: Long
        -title: String
        -duration: String
        -description: String
        -category: String
        -price: Double
        -ingredients: List~String~
        +addRecipe(recipe: Recipe)
        +getStats() ProviderStats
    }

    class Review {
        -id: Long
        -rating: Integer
        -comment: String
        -createdAt: Instant
        -providerReply: String
        -repliedAt: Instant
        +submit()
        +addProviderReply(reply: String)
    }

    class Subscription {
        -id: Long
        -subscribedAt: Instant
        +subscribe()
        +cancel()
    }

    class Save {
        -id: Long
        -savedAt: Instant
        +save()
        +remove()
    }

    Provider "1" --> "0..*" Recipe : publishes
    Provider "1" --> "0..*" Mealplan : publishes
    Provider "1" --> "0..*" Mealkit : publishes

    Mealplan "0..*" o-- "0..*" Recipe : includes
    Mealkit "0..*" o-- "0..*" Recipe : presets

    Customer "1" --> "0..*" Subscription : has
    Subscription "0..*" --> "1" Mealkit : for (paid content)

    Customer "1" --> "0..*" Save : has
    Save "0..*" --> "0..1" Recipe : saves (exactly one target)
    Save "0..*" --> "0..1" Mealplan : saves (exactly one target)

    Customer "1" --> "0..*" Review : writes
    Review "0..*" --> "0..1" Recipe : reviews (exactly one target)
    Review "0..*" --> "0..1" Mealplan : reviews (exactly one target)
    Review "0..*" --> "0..1" Mealkit : reviews (subscribers only)
